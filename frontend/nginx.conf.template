# Modèle : au démarrage, l'image nginx remplace ${ECOINDEX_DOMAIN} par la
# variable d'environnement (vide par défaut, voir Dockerfile.prod).

# Badge Ecoindex : pages du site qui en ont un (paramètre ?path= envoyé par le
# pied de page). Toute autre valeur répond 404 : le relais ne sert qu'à ces
# pages, et le cache ne garde qu'un badge par page.
map $arg_path $ecoindex_page {
    "/"                 "/";
    "/methodologie"     "/methodologie";
    "/a-propos"         "/a-propos";
    "/mentions-legales" "/mentions-legales";
    default             "";
}

# Cache des badges Ecoindex (voir location = /ecoindex-badge.svg).
proxy_cache_path /var/cache/nginx/ecoindex levels=1 keys_zone=ecoindex:1m max_size=1m inactive=7d;

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Compression des fichiers texte (écoconception, GreenIT RWEB_0076).
    # - Fichiers statiques : servis dans leur version .gz précompressée au
    #   build (gzip -9, une seule fois, voir Dockerfile.prod) : aucun calcul
    #   de compression par requête.
    # - Réponses de l'API (JSON) et fichiers sans .gz : compressés à la volée,
    #   à un niveau modéré (bon compromis entre gain réseau et CPU).
    # Les très petites réponses (< 1 Ko) ne gagnent rien à être compressées.
    gzip_static on;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/css
        text/plain
        application/javascript
        application/json
        image/svg+xml;

    # Badge Ecoindex de la page en cours, dans le pied de page :
    # /ecoindex-badge.svg?path=/a-propos analyse https://<ECOINDEX_DOMAIN>/a-propos.
    # ECOINDEX_DOMAIN est le domaine public du site (par exemple
    # ai-calculator.greenit.eco) ; vide, le badge et son lien répondent 404
    # et le pied de page n'affiche rien.
    # Le badge est relayé par ce serveur au lieu d'être chargé chez
    # ecoindex.fr par le navigateur : aucun service tiers ne reçoit l'adresse
    # IP des visiteurs (voir les mentions légales). Une requête par page et par
    # jour au plus vers ecoindex.fr, quel que soit le nombre de visites, sans
    # en-tête du visiteur ; en cas d'échec, la dernière version en cache reste
    # servie.
    set $ecoindex_domain "${ECOINDEX_DOMAIN}";

    location = /ecoindex-badge.svg {
        if ($ecoindex_domain = "") {
            return 404;
        }
        if ($ecoindex_page = "") {
            return 404;
        }
        # Résolution DNS au moment de la requête (DNS de Docker) : si
        # ecoindex.fr est injoignable, seul le badge manque, nginx démarre.
        resolver 127.0.0.11 valid=1h ipv6=off;
        proxy_pass https://bff.ecoindex.fr/badge/?theme=light&url=https://$ecoindex_domain$ecoindex_page;
        proxy_ssl_server_name on;
        proxy_pass_request_headers off;
        proxy_set_header Host bff.ecoindex.fr;
        proxy_cache ecoindex;
        proxy_cache_key $ecoindex_domain$ecoindex_page;
        proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
        proxy_hide_header Cache-Control;
        proxy_hide_header Vary;
        proxy_cache_valid 200 1d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        add_header Cache-Control "public, max-age=86400";
    }

    # Lien du badge : le résultat de l'analyse de la page sur ecoindex.fr.
    location = /ecoindex {
        if ($ecoindex_domain = "") {
            return 404;
        }
        if ($ecoindex_page = "") {
            return 404;
        }
        return 302 https://bff.ecoindex.fr/redirect/?url=https://$ecoindex_domain$ecoindex_page;
    }

    location /api/ {
        proxy_pass http://backend:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Cache navigateur (écoconception, GreenIT RWEB_0075).
    # - /assets/ : fichiers du build dont le nom contient un hash de leur
    #   contenu ; une nouvelle version change leur nom. Ils peuvent donc être
    #   gardés un an sans jamais être revérifiés (immutable). Un fichier absent
    #   renvoie 404 au lieu de index.html, pour ne pas mettre en cache une page
    #   HTML sous l'URL d'un asset.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # - index.html (et toutes les routes de l'application, qui le servent) :
    #   revérifié à chaque visite (no-cache), pour référencer les assets de la
    #   dernière version ; s'il n'a pas changé, nginx répond 304 sans le corps.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri /index.html;
    }
}
