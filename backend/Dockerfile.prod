FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv
ENV UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --no-install-project

COPY . .
RUN uv sync

# Short commit of staging images (.github/workflows/build-images.yml), added
# to the version returned with the results (meta.app_version); empty for
# release images. Declared last so that it does not invalidate the layers above.
ARG APP_BUILD=""
ENV APP_BUILD=${APP_BUILD}

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "ai_calculator.main:app", "--host", "0.0.0.0", "--port", "8000"]
